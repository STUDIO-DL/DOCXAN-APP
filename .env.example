# Copia a .env y no lo subas. Las claves van por --dart-define o secrets de CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_DEV=doxan-backups-dev
R2_BUCKET_PROD=doxan-backups-prod

# AdMob (solo banner). Por defecto la app usa IDs de prueba de Google.
# App ID de producción: ADMOB_APP_ID en gradle.properties o -PADMOB_APP_ID=ca-app-pub-…~…
# Banner unit ID (env.json / dart-define):
# ADMOB_ANDROID_BANNER_AD_UNIT_ID=ca-app-pub-…/…
